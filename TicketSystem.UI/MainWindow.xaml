<Window x:Class="TicketSystem.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система учета заявок" Height="500" Width="900" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Разбиваем окно на две колонки -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: Форма создания заявки -->
        <Border BorderBrush="LightGray" BorderThickness="0,0,1,0" Padding="15">
            <StackPanel>
                <TextBlock Text="Новая заявка" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="Тема:" Margin="0,0,0,5"/>
                <TextBox x:Name="TitleInput" Margin="0,0,0,10" Padding="3"/>

                <TextBlock Text="Автор:" Margin="0,0,0,5"/>
                <TextBox x:Name="AuthorInput" Margin="0,0,0,10" Padding="3"/>

                <TextBlock Text="Приоритет:" Margin="0,0,0,5"/>
                <ComboBox x:Name="PriorityInput" Margin="0,0,0,10" Padding="3" SelectedIndex="1">
                    <ComboBoxItem Content="Низкий"/>
                    <ComboBoxItem Content="Обычный"/>
                    <ComboBoxItem Content="Высокий"/>
                </ComboBox>

                <TextBlock Text="Описание:" Margin="0,0,0,5"/>
                <TextBox x:Name="DescriptionInput" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15" Padding="3"/>

                <Button Content="Добавить заявку" Click="Add_Click" Height="35" Margin="0,0,0,10" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                <Button Content="Удалить выбранную" Click="Delete_Click" Height="30" Margin="0,0,0,10" Background="#F44336" Foreground="White"/>
                <Button Content="Обновить таблицу" Click="Refresh_Click" Height="30"/>
            </StackPanel>
        </Border>

        <!-- Правая колонка: Таблица данных -->
        <DataGrid Name="RequestsGrid" Grid.Column="1" Margin="15" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column"/>
    </Grid>
</Window>